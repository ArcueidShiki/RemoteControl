# Local deliverables and review evidence; never part of a source package.
/artifacts/
node_modules/
*.log
*.tmp
.DS_Store
Thumbs.db

# Local credentials and signing material are never source inputs.
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key

# Editor state and any retained local files from the retired MFC workspace.
.vs/
*.suo
*.user
*.rsuser
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Desktop build outputs, test profiles and screenshots live under desktop/;
# their ignore rules are maintained in desktop/.gitignore.
