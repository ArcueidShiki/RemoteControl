{
  "name": "remotecontrol-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Guided connection workspace with an explicitly external session preview",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/electron-ui.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "test:instances": "node tests/packaged-single-instance.cjs",
    "test:engine": "node tests/trusted-engine.cjs",
    "package:win": "node scripts/build-windows.cjs",
    "package:mac": "node scripts/package.cjs darwin arm64"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/cli": "0.1.22",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.60.0"
  }
}
